                    <mxGeometry x="10" y="100" width="450" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="83" value="&lt;b&gt;Cas 3 — Actionneur défaillant&lt;/b&gt;&lt;br/&gt;Absence d&#39;effet sur capteur après 5 min → désactivation de l&#39;actionneur + alerte. Ticket maintenance déclenché." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" parent="80" vertex="1">
