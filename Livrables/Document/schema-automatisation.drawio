                </mxCell>
                <mxCell id="72" value="🔴 &lt;b&gt;Arrêt d&#39;urgence — E-STOP&lt;/b&gt;&lt;br/&gt;Bouton physique câblé en coupure directe (hors logiciel). Coupe l&#39;alimentation 24V de tous les actionneurs. Position repos = sécurité passive." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;" parent="70" vertex="1">
                    <mxGeometry x="10" y="103" width="430" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="73" value="⏱ &lt;b&gt;Watchdog logiciel (60s)&lt;/b&gt;&lt;br/&gt;Si aucune mesure capteur reçue depuis &gt; 60s → SAFE STATE (tous actionneurs OFF). Protège en cas de perte réseau ou crash backend." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;" parent="70" vertex="1">
                    <mxGeometry x="10" y="168" width="430" height="55" as="geometry"/>
                </mxCell>
